diff --git a/src/egl/drivers/dri2/platform_x11.c b/src/egl/drivers/dri2/platform_x11.c
index a31a9d353ab..9c51ae8d621 100644
--- a/src/egl/drivers/dri2/platform_x11.c
+++ b/src/egl/drivers/dri2/platform_x11.c
@@ -978,6 +978,10 @@ static_assert(sizeof(struct kopper_vk_surface_create_storage) >=
                  sizeof(VkXcbSurfaceCreateInfoKHR),
               "");
 
+static_assert(sizeof(struct kopper_vk_surface_create_storage) >=
+                 sizeof(VkHeadlessSurfaceCreateInfoEXT),
+              "");
+
 static void
 kopperSetSurfaceCreateInfo(void *_draw, struct kopper_loader_info *ci)
 {
@@ -986,6 +990,38 @@ kopperSetSurfaceCreateInfo(void *_draw, struct kopper_loader_info *ci)
       dri2_egl_display(dri2_surf->base.Resource.Display);
    VkXcbSurfaceCreateInfoKHR *xcb = (VkXcbSurfaceCreateInfoKHR *)&ci->bos;
 
+   /* ============================================================================
+    * ⚠ PROBE INSTRUMENT - MUST NOT SHIP. NOT PART OF THE KOPPER_HEADLESS CHANGE.
+    *
+    * Ask kopper for a VK_EXT_headless_surface swapchain instead of an xcb one,
+    * leaving every other part of the EGL/X11 drawable plumbing alone. This is a
+    * TEST HARNESS for the KOPPER_HEADLESS arm in zink_kopper.c, which is the
+    * real change; it exists because no upstream loader ever asks kopper for a
+    * headless surface, so without it that arm is unreachable and unprovable.
+    *
+    * The X11 window is only the vehicle that gets us a window-type EGL surface
+    * with a working swap loop - surfaceless EGL only does pbuffers, and
+    * eglSwapBuffers on a pbuffer is a no-op, so it cannot exercise present at
+    * all. Nothing is displayed: the headless WSI backend consumes the presented
+    * image. Verification is therefore by rendering into the swapchain image and
+    * reading it back (build-support/orbis/tools/kopperprobe.c), never by looking
+    * at the screen.
+    *
+    * The console does NOT want this hunk. It wants a real PS4 EGL platform that
+    * fills in a VkHeadlessSurfaceCreateInfoEXT because that is genuinely what it
+    * presents through - not an env var bolted onto the X11 backend.
+    * ============================================================================ */
+   if (getenv("ZINK_PROBE_HEADLESS")) {
+      VkHeadlessSurfaceCreateInfoEXT *headless =
+         (VkHeadlessSurfaceCreateInfoEXT *)&ci->bos;
+      headless->sType = VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT;
+      headless->pNext = NULL;
+      headless->flags = 0;
+      ci->has_alpha = dri2_surf->depth == 32;
+      ci->present_opaque = dri2_surf->base.PresentOpaque;
+      return;
+   }
+
    xcb->sType = VK_STRUCTURE_TYPE_XCB_SURFACE_CREATE_INFO_KHR;
    xcb->pNext = NULL;
    xcb->flags = 0;
diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index 9c83af6ef20..bffa2d3c490 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -3594,7 +3594,22 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
    }
 
    zink_internal_setup_moltenvk(screen);
-   if (!screen->info.have_KHR_timeline_semaphore && !screen->info.feats12.timelineSemaphore) {
+   /* ============================================================================
+    * ⚠ PROBE INSTRUMENT - MUST NOT SHIP. NOT PART OF THE KOPPER_HEADLESS CHANGE.
+    *
+    * The Orbis winsys leaves util_sync_provider::timeline_wait NULL on purpose
+    * (ac_orbis_drm.c), so ac_gpu_info.c sets has_timeline_syncobj = false, so
+    * radv_physical_device.c gates KHR_timeline_semaphore and feats12.timeline-
+    * Semaphore off, so this check rejects the driver before zink ever gets a
+    * screen. ZINK_PROBE_NO_TIMELINE exists ONLY to see what lies beyond that
+    * gate. It answered its question: RADV already installs an emulated timeline
+    * sync type when has_timeline_syncobj is false, zink_screen_init_semaphore()
+    * then creates a real VK_SEMAPHORE_TYPE_TIMELINE semaphore successfully, and
+    * GL 4.6 comes up. The real fix belongs in RADV - advertise the extension
+    * when a timeline sync type exists rather than when the kernel provides one -
+    * NOT here. Delete this hunk once that lands.
+    * ============================================================================ */
+   if (!screen->info.have_KHR_timeline_semaphore && !screen->info.feats12.timelineSemaphore && !getenv("ZINK_PROBE_NO_TIMELINE")) {
       if (!screen->driver_name_is_inferred)
          mesa_loge("zink: KHR_timeline_semaphore is required");
       goto fail;
